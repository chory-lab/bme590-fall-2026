# Quarto working state
/.quarto/
**/*.quarto_ipynb

# Render output. `output-dir: _site`, but single-file renders drop HTML next to
# the source, so ignore both shapes.
/_site/
*.html
!_edit-button.html
*_files/
/site_libs/
*-listing.json

# Execution cache. Deliberately NOT committed: the README's anti-rot rule is that
# CI clears the cache and re-executes every recipe against the pinned PLR, so a
# committed cache would only mask API drift.
/_freeze/
