__pycache__/
*.egg-info
.vscode
.DS_Store
assignments/
cookbook/_site/
cookbook/_freeze/

# Render environment for the cookbook: PLR 0.2.2 + jupyter.
# Recreate with:
#   py -3.13 -m venv .venv-cookbook
#   .venv-cookbook/Scripts/python -m pip install "pylabrobot==0.2.2" jupyter
.venv-cookbook/

# Workshop 5 run artifacts (generated by executing the notebooks).
workshop_5_imager_data/
workshop_5_plate_reader_output/

# Rendered workshops site (build artifact of build_workshops_site.py).
site/

# Static Pyodide demo (build artifact of plr_workshops/build_demo.py).
demo/

# Third-party assets fetched by plr_workshops/vendor.py so the demo runs with
# no network. The cache is build output; _vendored/ (konva + shrunk logo) is
# COMMITTED so deck.html builds offline from any checkout.
.vendor-cache/

# pyodide, a devDependency used only by test_demo_pyodide.mjs.
node_modules/

# JupyterLite driver + host-bridge deps (dev-only).
jupyterlite/node_modules/
jupyterlite/package-lock.json

# bridge.js is COMMITTED: it is the deterministic esbuild bundle of
# bridge-entry.mjs (5 lines + two pinned deps) that CI and static hosts serve;
# regenerating it needs npm, which the build workflow does not run.


# JupyterLite spike build output (rebuilt by jupyterlite/build.py).
jupyterlite/output/
jupyterlite/deploy/
jupyterlite/.cache/
jupyterlite/.jupyterlite.doit.db
.cache/
.jupyterlite.doit.db

# Browser-ready workshop copies (bootstrap cell prepended) generated by
# jupyterlite/build.py from workshops/ + data/ + figs/.
jupyterlite/content/

# The deck iframe document, generated host-side by build.py from the installed
# PyLabRobot (frontend.build_page). Rebuilt with the site; never committed.
jupyterlite/deck.html

# setuptools temp dir left by `pip wheel` (building the kernel wheel).
build/

# The student environment, built by install.ps1 / install.sh from uv.lock.
# uv.lock and .python-version ARE committed: they are what makes every student's
# install identical and reproducible.
.venv/

# Offline install bundles, built by scripts/build_wheelhouse.py (and by CI, which
# attaches them to releases). Too large to commit; rebuilt from uv.lock.
dist/
.wheelhouse/

# Workshop 4 exercise 4 output, written by running the notebook (or the
# autograder) -- it is a submission artifact, not repo content.
data/exercise_4.csv

# The answer key. It lives in a separate PRIVATE repo and is cloned into
# solutions/ when needed:
#   git clone https://github.com/stefangolas/bme590-fall-2026-solutions solutions
# This repo is public, so the directory must never be committed here.
solutions/
