__pycache__/
*.egg-info
.vscode
.DS_Store
assignments/
cookbook/_site/
cookbook/_freeze/

# Render environment for the cookbook: PLR 0.2.2 + jupyter.
# Recreate with:
#   py -3.13 -m venv .venv-cookbook
#   .venv-cookbook/Scripts/python -m pip install "pylabrobot==0.2.2" jupyter
.venv-cookbook/

# Workshop 5 run artifacts (generated by executing the notebooks).
workshop_5_imager_data/
workshop_5_plate_reader_output/

# Rendered workshops site (build artifact of build_workshops_site.py).
site/

# Static Pyodide demo (build artifact of plr_workshops/build_demo.py).
demo/

# Third-party assets fetched by plr_workshops/vendor.py so the demo runs with
# no network. Both are build output: `python -m plr_workshops.build_demo`
# recreates them, and the cache makes a rebuild itself offline.
.vendor-cache/
plr_workshops/_vendored/

# pyodide, a devDependency used only by test_demo_pyodide.mjs.
node_modules/